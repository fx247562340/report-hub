# Copy to .env on the deployment host (never commit .env to Git)
WEB_PORT=15173
DB_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-at-least-32-random-bytes-secret!
CORS_ORIGINS=*
JAVA_OPTS=-Xms512m -Xmx2048m

